APP_NAME="English Learning API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_PORT=8088
APP_UID=1000
APP_GID=1000
XDEBUG_MODE=debug,develop
AUTH_PIN_PEPPER=change-me

# Optional static update-source settings. Release versions are discovered
# automatically from GitHub and never need to be changed per release.
APP_UPDATE_GITHUB_REPOSITORY=garikgsi/en_learning_tg_app
APP_UPDATE_CHANNEL=prerelease
APP_UPDATE_CACHE_TTL_SECONDS=900

# Optional dictionary provider overrides. DICTIONARY_TRANSLATION_EMAIL raises
# the anonymous MyMemory usage allowance when configured.
DICTIONARY_TRANSLATION_URL=https://api.mymemory.translated.net/get
DICTIONARY_TRANSLATION_EMAIL=
DICTIONARY_PRONUNCIATION_URL=https://api.dictionaryapi.dev/api/v2/entries/en
DICTIONARY_TRANSLATION_DRIVER=my_memory
DICTIONARY_PHONETICS_DRIVER=merriam_webster_fallback
DICTIONARY_SPEECH_DRIVER=merriam_webster_voice_rss
DICTIONARY_AUDIO_DISK=dictionary_audio
# DICTIONARY_AUDIO_PATH=/var/lib/en-learning/dictionary-audio

# Merriam-Webster Learner's Dictionary with Audio
MERRIAM_WEBSTER_API_KEY=
MERRIAM_WEBSTER_URL=https://www.dictionaryapi.com/api/v3/references
MERRIAM_WEBSTER_REFERENCE=learners
MERRIAM_WEBSTER_AUDIO_URL=https://media.merriam-webster.com/audio/prons/en/us/mp3

# Voice RSS fallback text-to-speech
VOICE_RSS_API_KEY=
VOICE_RSS_URL=https://api.voicerss.org
VOICE_RSS_LANGUAGE=en-us
VOICE_RSS_VOICE=Amy
VOICE_RSS_AUDIO_FORMAT=24khz_16bit_mono

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_FORWARD_PORT=5432
DB_DATABASE=en_learning
DB_USERNAME=en_learning
DB_PASSWORD=en_learning

PGADMIN_PORT=5050
PGADMIN_EMAIL=pgadmin4@pgadmin.org
PGADMIN_PASSWORD=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

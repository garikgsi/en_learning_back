### Get achievement medals for all grammar-race games
# Games without a profile start at level 1. medalTier is a normalized colour
# category from 1 (starting medal) through 5 (the maximum level for that game).
# levelUp describes the shared requirements for advancing to the next level.
# @name getGrammarRaceAchievements
GET {{baseUrl}}/api/v1/grammar-race-achievements
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get personal-pronoun race availability and active session
# The day resets in Europe/Moscow. The first attempt is free; the next two cost
# one EnCoin each. An abandoned or unfinished session consumes its attempt.
# activeSession contains only an unfinished competitive task pack. Training
# results are local-only and training sessions are not restored by this status.
# @name getPersonalPronounRaceStatus
GET {{baseUrl}}/api/v1/grammar-race-games/personal_pronouns/status
Accept: application/json
Authorization: Bearer {{accessToken}}

### Start an idempotent personal-pronoun race session
# Persist clientRequestId before sending. If the response is lost after a paid
# attempt is charged, retrying the same request returns the same session and
# never charges again. Only one competitive session can be active at a time.
# The response contains 50 balanced tasks and precomputed bot behaviour, so the
# match can continue offline. Task positions repeat from 1 after pack exhaustion.
# Each task contains a type, renderer payload and its own option id/label list.
# @name startPersonalPronounRace
POST {{baseUrl}}/api/v1/grammar-race-games/personal_pronouns/sessions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientRequestId": "01993a00-1234-7000-8000-123456789abc",
    "playMode": "competitive"
}

### Get possessive-pronoun race availability and active session
# Available from grade 5. It has five sentence-only difficulty levels. Daily
# attempts, progress and active sessions are independent from the personal game.
# @name getPossessivePronounRaceStatus
GET {{baseUrl}}/api/v1/grammar-race-games/possessive_pronouns/status
Accept: application/json
Authorization: Bearer {{accessToken}}

### Start an idempotent possessive-pronoun race session
# The first competitive attempt is free; the next two cost one EnCoin each.
# Use playMode=training for unlimited play without attempts, rewards or progress.
# @name startPossessivePronounRace
POST {{baseUrl}}/api/v1/grammar-race-games/possessive_pronouns/sessions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientRequestId": "01993a00-1234-7000-8000-123456789abe",
    "playMode": "competitive"
}

### Get article race availability and active session
# Available from grade 3. Levels 1-5 use words and short phrases; levels 6-10
# use full sentences. Incorrect and missed answers include child-friendly feedback.
# @name getArticleRaceStatus
GET {{baseUrl}}/api/v1/grammar-race-games/articles/status
Accept: application/json
Authorization: Bearer {{accessToken}}

### Start an idempotent article race session
# Use playMode=training for unlimited play without attempts, rewards or progress.
# @name startArticleRace
POST {{baseUrl}}/api/v1/grammar-race-games/articles/sessions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientRequestId": "01993a00-1234-7000-8000-123456789abf",
    "playMode": "competitive"
}

### Start an unlimited training session (no attempt, coin or reward)
# The client does not upload training results. A previously unfinished training
# session is closed automatically when another session is started.
# @name startPronounTraining
POST {{baseUrl}}/api/v1/grammar-race-games/personal_pronouns/sessions
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientRequestId": "01993a00-1234-7000-8000-123456789abd",
    "playMode": "training"
}

### Restore a grammar-race session
# Only the owning user can access the session.
# @name getGrammarRaceSession
GET {{baseUrl}}/api/v1/grammar-race-sessions/01993a00-1234-7000-8000-123456789abc
Accept: application/json
Authorization: Bearer {{accessToken}}

### Complete a grammar-race session, including after an offline match
# The server derives every round outcome from its stored task, bot answer and
# timing. A correct answer at exactly botDelayMs wins the tie. After an early
# wrong answer, the bot answers in 500 ms. If the bot is also wrong, the student
# gets a second attempt until the original botDelayMs plus the 5-second phrase
# or 10-second sentence window.
# Save this payload in an offline queue and retry it unchanged. First acceptance
# returns 201; an identical retry returns 200. A student win awards two EnCoin
# exactly once. A valid paid or free result has no synchronization expiry.
# The answers below are illustrative: use the task order and answers returned by
# the start request. The submitted rounds must end exactly on the winning point.
# @name completeGrammarRaceSession
POST {{baseUrl}}/api/v1/grammar-race-sessions/01993a00-1234-7000-8000-123456789abc/complete
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientResultId": "01993a10-1234-7000-8000-123456789abc",
    "completedAt": "2026-09-22T12:05:00Z",
    "rounds": [
        {
            "taskPosition": 1,
            "playerAnswer": "he",
            "playerAnswerMs": 2450,
            "secondPlayerAnswer": null,
            "secondPlayerAnswerMs": null
        },
        {
            "taskPosition": 2,
            "playerAnswer": "she",
            "playerAnswerMs": 2100
        },
        {
            "taskPosition": 3,
            "playerAnswer": "it",
            "playerAnswerMs": 1800
        },
        {
            "taskPosition": 4,
            "playerAnswer": "we",
            "playerAnswerMs": 2300
        },
        {
            "taskPosition": 5,
            "playerAnswer": "they",
            "playerAnswerMs": 1950
        }
    ]
}

### Abandon a grammar-race session after the user's confirmation
# Abandoning is a loss. The daily attempt remains consumed and a paid entry is
# not refunded. This request is idempotent and can also be queued offline.
# @name abandonGrammarRaceSession
POST {{baseUrl}}/api/v1/grammar-race-sessions/01993a00-1234-7000-8000-123456789abc/abandon
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "clientResultId": "01993a20-1234-7000-8000-123456789abc",
    "abandonedAt": "2026-09-22T12:03:00Z"
}

### Register or refresh a notification device
# installationId is generated once by the app installation and persisted locally.
# Repeat this request when FCM returns a token or the token changes.
# @name registerNotificationDevice
PUT {{baseUrl}}/api/v1/notification-devices
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "installationId": "e2668dcb-a7cf-4de6-9d23-10e79bc96f32",
    "pushToken": "fcm-registration-token-from-device",
    "platform": "android",
    "notificationsEnabled": true
}

### Incrementally synchronize notifications
# Persist nextSequence locally and pass it as afterSequence on the next sync.
# Repeat while hasMore is true.
# Balance notifications: encoin.credited (daily/weekly rewards and weekly bonus),
# encoin.withdrawal.processed (administrator confirmed payment and coin deduction).
# data.route=/balance; data.amount is signed, data.balance is balance after change.
# data.amountRubles uses the reward/request rate snapshot.
# Notifications and push jobs are deduplicated by ledger entry; push follows
# device preferences and the existing delivery window, after transaction commit.
# @name syncNotifications
GET {{baseUrl}}/api/v1/notifications?afterSequence=0&perPage=100
Accept: application/json
Authorization: Bearer {{accessToken}}

### Mark a notification as read
# @name markNotificationRead
PATCH {{baseUrl}}/api/v1/notifications/13c52fd9-4562-495c-86b7-177f19686ff6/read
Accept: application/json
Authorization: Bearer {{accessToken}}

### Remove this app installation from push delivery
# @name removeNotificationDevice
DELETE {{baseUrl}}/api/v1/notification-devices/e2668dcb-a7cf-4de6-9d23-10e79bc96f32
Accept: application/json
Authorization: Bearer {{accessToken}}

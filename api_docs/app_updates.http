### Get the latest Android APK release discovered from GitHub Releases
# The backend caches the manifest and falls back to the last valid release
# when GitHub is temporarily unavailable.
# @name getLatestAppUpdate
GET {{baseUrl}}/api/v1/app-updates/latest
Accept: application/json
Authorization: Bearer {{accessToken}}

### Force refresh the latest Android APK release
# The backend limits forced GitHub refreshes to one request per minute.
# @name refreshLatestAppUpdate
GET {{baseUrl}}/api/v1/app-updates/latest?refresh=1
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get exercises for an inclusive period
# @name getExercisesForPeriod
GET {{baseUrl}}/api/v1/exercises?dateFrom=2026-07-29T00:00:00%2B03:00&dateTo=2026-07-29T23:59:59%2B03:00
Accept: application/json
Authorization: Bearer {{accessToken}}

### Create a user exercise for the current date
# Returns 409 DICTIONARY_EMPTY with "Нет слов в словаре" when no words are
# available; an exercise is not created in that case.
# @name createUserExercise
POST {{baseUrl}}/api/v1/exercises
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get uncompleted exercises due today
# @name getCurrentExercises
GET {{baseUrl}}/api/v1/exercises/current
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get calendar statistics plus current week/month charts for all users
# Calendar items use the requested inclusive period and current user.
# charts.week and charts.month contain every user with learnedWords,
# wordsToRepeat and completedExercises, including user-created exercises.
# A word error percentage is the share of its checked directions with errors.
# attentionWords contains current-user words above 50% errors this month.
# @name getExerciseStatistics
GET {{baseUrl}}/api/v1/exercises/statistics?dateFrom=2026-07-01T00:00:00%2B03:00&dateTo=2026-07-31T23:59:59%2B03:00
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get a selected exercise (completed user exercises return 409)
# @name getSelectedExercise
GET {{baseUrl}}/api/v1/exercises/1
Accept: application/json
Authorization: Bearer {{accessToken}}

### Save exercise completion results
# @name completeExercise
POST {{baseUrl}}/api/v1/exercises/complete
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "exercise_id": 1,
    "exercise_items_result": [
        {
            "exercise_item_id": 1,
            "errors_count": 1,
            "hints_count": 0,
            "lang_id": 1,
            "variants": ["cat", "cut"]
        }
    ]
}
